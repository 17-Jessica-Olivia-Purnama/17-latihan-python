#Fungsi untuk mengecek apakah sebuah angka ganjil atau genap
def cek_ganjil_genap(angka):
    if angka % 2 == 0:
        return "Genap"
    else:
        return "Ganjil"

# Contoh penggunaan:
print(cek_ganjil_genap(10))  # Output: Genap
print(cek_ganjil_genap(7))   # Output: Ganjil

